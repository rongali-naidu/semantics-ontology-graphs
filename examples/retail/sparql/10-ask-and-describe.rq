# Q10. ASK returns true/false. (DESCRIBE ex:P4 would return a graph about P4;
# its exact shape is implementation-defined.)
# Did anyone ever pay less than list price?  -> true (O3, earbuds on sale)
PREFIX rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs:   <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl:    <http://www.w3.org/2002/07/owl#>
PREFIX xsd:    <http://www.w3.org/2001/XMLSchema#>
PREFIX retail: <https://example.org/retail/ontology#>
PREFIX ex:     <https://example.org/retail/data/>

ASK {
  ?line retail:forProduct ?p ; retail:unitPrice ?paid .
  ?p retail:price ?list .
  FILTER(?paid < ?list)
}
