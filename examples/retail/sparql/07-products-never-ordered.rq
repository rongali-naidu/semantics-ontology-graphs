# Q7. Negation: products that appear on no order line.
# Expected: Mechanical Keyboard
PREFIX rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs:   <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl:    <http://www.w3.org/2002/07/owl#>
PREFIX xsd:    <http://www.w3.org/2001/XMLSchema#>
PREFIX retail: <https://example.org/retail/ontology#>
PREFIX ex:     <https://example.org/retail/data/>

SELECT ?productName
WHERE {
  ?product a retail:Product ; retail:name ?productName .
  FILTER NOT EXISTS { ?line retail:forProduct ?product }
}
