<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
  xmlns:retail="https://example.org/retail/ontology#"
  xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
>
  <retail:Review rdf:about="https://example.org/retail/data/R2">
    <retail:writtenBy>
      <retail:Customer rdf:about="https://example.org/retail/data/C2">
        <retail:name>Bob Smith</retail:name>
        <retail:email>bob@example.com</retail:email>
        <retail:hasAddress rdf:resource="https://example.org/retail/data/A2"/>
      </retail:Customer>
    </retail:writtenBy>
    <retail:reviewOf>
      <retail:Product rdf:about="https://example.org/retail/data/P4">
        <retail:name>Knowledge Graphs 101</retail:name>
        <retail:sku>BK-KG101</retail:sku>
        <retail:price rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">49.99</retail:price>
        <retail:inCategory rdf:resource="https://example.org/retail/data/CAT-BOOKS"/>
        <retail:soldBy rdf:resource="https://example.org/retail/data/S2"/>
      </retail:Product>
    </retail:reviewOf>
    <retail:rating rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</retail:rating>
    <retail:reviewText>Great intro to graphs.</retail:reviewText>
  </retail:Review>
  <retail:Order rdf:about="https://example.org/retail/data/O4">
    <retail:placedBy>
      <retail:PremiumCustomer rdf:about="https://example.org/retail/data/C3">
        <retail:name>Carol Diaz</retail:name>
        <retail:email>carol@example.com</retail:email>
        <retail:memberSince rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-11-01</retail:memberSince>
        <retail:hasAddress rdf:resource="https://example.org/retail/data/A3"/>
      </retail:PremiumCustomer>
    </retail:placedBy>
    <retail:orderDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-02</retail:orderDate>
    <retail:status>PLACED</retail:status>
    <retail:paymentMethod>GIFT_CARD</retail:paymentMethod>
    <retail:shipsTo>
      <retail:Address rdf:about="https://example.org/retail/data/A3">
        <retail:city>New York</retail:city>
        <retail:state>NY</retail:state>
        <retail:postalCode>10001</retail:postalCode>
        <retail:country>US</retail:country>
      </retail:Address>
    </retail:shipsTo>
    <retail:hasLine>
      <retail:OrderLine rdf:about="https://example.org/retail/data/O4-L1">
        <retail:forProduct rdf:resource="https://example.org/retail/data/P5"/>
        <retail:quantity rdf:datatype="http://www.w3.org/2001/XMLSchema#positiveInteger">1</retail:quantity>
        <retail:unitPrice rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">79.50</retail:unitPrice>
      </retail:OrderLine>
    </retail:hasLine>
    <retail:hasLine>
      <retail:OrderLine rdf:about="https://example.org/retail/data/O4-L2">
        <retail:forProduct rdf:resource="https://example.org/retail/data/P4"/>
        <retail:quantity rdf:datatype="http://www.w3.org/2001/XMLSchema#positiveInteger">2</retail:quantity>
        <retail:unitPrice rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">49.99</retail:unitPrice>
      </retail:OrderLine>
    </retail:hasLine>
  </retail:Order>
  <retail:Product rdf:about="https://example.org/retail/data/P6">
    <retail:name>Mechanical Keyboard</retail:name>
