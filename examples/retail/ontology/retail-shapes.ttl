#############################################################################
#  Retail Ordering - SHACL shapes (data validation)
#  -----------------------------------------------------------------------
#  OWL describes what is TRUE about the world (open-world: missing data is
#  just unknown). SHACL describes what valid DATA must look like
#  (closed-world checks: "every order MUST have a date").
#
#  Validate locally:
#     pyshacl -s retail-shapes.ttl -e retail-ontology.ttl -i rdfs ../rdf/retail-data.ttl
#  Spec: https://www.w3.org/TR/shacl/
#############################################################################

@prefix sh:     <http://www.w3.org/ns/shacl#> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .
@prefix retail: <https://example.org/retail/ontology#> .
@prefix shape:  <https://example.org/retail/shapes#> .

shape:CustomerShape a sh:NodeShape ;
    sh:targetClass retail:Customer ;          # with RDFS inference also hits PremiumCustomer
    sh:property [
        sh:path retail:name ; sh:datatype xsd:string ;
        sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [
        sh:path retail:email ; sh:datatype xsd:string ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:pattern "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$" ;
        sh:message "Customer needs exactly one well-formed email." ] ;
    sh:property [
        sh:path retail:hasAddress ; sh:class retail:Address ; sh:minCount 1 ] .

shape:PremiumCustomerShape a sh:NodeShape ;
    sh:targetClass retail:PremiumCustomer ;
    sh:property [
        sh:path retail:memberSince ; sh:datatype xsd:date ;
        sh:minCount 1 ; sh:maxCount 1 ] .

shape:ProductShape a sh:NodeShape ;
    sh:targetClass retail:Product ;
    sh:property [ sh:path retail:name ; sh:datatype xsd:string ; sh:minCount 1 ] ;
    sh:property [ sh:path retail:sku  ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [
        sh:path retail:price ; sh:datatype xsd:decimal ;
        sh:minCount 1 ; sh:maxCount 1 ; sh:minExclusive 0 ] ;
    sh:property [ sh:path retail:inCategory ; sh:class retail:Category ; sh:minCount 1 ] ;
    sh:property [ sh:path retail:soldBy ; sh:class retail:Seller ; sh:minCount 1 ; sh:maxCount 1 ] .

shape:OrderShape a sh:NodeShape ;
    sh:targetClass retail:Order ;
    sh:property [ sh:path retail:placedBy ; sh:class retail:Customer ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path retail:orderDate ; sh:datatype xsd:date ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path retail:status ; sh:in ( "PLACED" "SHIPPED" "DELIVERED" "CANCELLED" ) ; sh:minCount 1 ] ;
    sh:property [ sh:path retail:shipsTo ; sh:class retail:Address ; sh:maxCount 1 ] ;
    sh:property [ sh:path retail:hasLine ; sh:class retail:OrderLine ; sh:minCount 1 ;
                  sh:message "An order must contain at least one order line." ] .

shape:OrderLineShape a sh:NodeShape ;
    sh:targetClass retail:OrderLine ;
    sh:property [ sh:path retail:forProduct ; sh:class retail:Product ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path retail:quantity ; sh:datatype xsd:positiveInteger ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path retail:unitPrice ; sh:datatype xsd:decimal ; sh:minCount 1 ; sh:minInclusive 0 ] .

shape:ReviewShape a sh:NodeShape ;
    sh:targetClass retail:Review ;
    sh:property [ sh:path retail:writtenBy ; sh:class retail:Customer ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path retail:reviewOf ; sh:class retail:Product ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [
        sh:path retail:rating ; sh:datatype xsd:integer ;
        sh:minInclusive 1 ; sh:maxInclusive 5 ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "Rating must be an integer between 1 and 5." ] .
