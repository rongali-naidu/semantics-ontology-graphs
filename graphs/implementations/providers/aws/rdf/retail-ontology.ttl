#############################################################################
#  Retail Ordering Ontology (TBox)
#  -----------------------------------------------------------------------
#  A small OWL 2 ontology for an online marketplace (think "Amazon-style"
#  ordering): customers place orders, orders contain order lines, each line
#  points to a product, products belong to categories and are sold by
#  sellers, customers write reviews.
#
#  Serialization: Turtle (https://www.w3.org/TR/turtle/)
#  Vocabularies:  RDF, RDFS, OWL 2, XSD, SKOS (labels/definitions),
#                 Dublin Core terms (metadata), schema.org (alignment)
#
#  The instance data (ABox) lives in ../rdf/retail-data.ttl
#############################################################################

@prefix rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:    <http://www.w3.org/2002/07/owl#> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:   <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms:<http://purl.org/dc/terms/> .
@prefix schema: <https://schema.org/> .
@prefix retail: <https://example.org/retail/ontology#> .

#---------------------------------------------------------------------------
# Ontology header (metadata)
#---------------------------------------------------------------------------
<https://example.org/retail/ontology>
    a owl:Ontology ;
    owl:versionIRI <https://example.org/retail/ontology/1.0.0> ;
    owl:versionInfo "1.0.0" ;
    dcterms:title "Retail Ordering Ontology"@en ;
    dcterms:description "Teaching ontology for an online marketplace: customers, orders, products, categories, sellers and reviews."@en ;
    dcterms:creator "semantics-ontology-graphs" ;
    dcterms:source <https://github.com/rongali-naidu/semantics-ontology-graphs> ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:created "2026-10-28"^^xsd:date ;
    rdfs:comment "Instance data is kept in a separate file (ABox) from this schema (TBox)."@en .

#---------------------------------------------------------------------------
# Classes
#---------------------------------------------------------------------------
retail:Party a owl:Class ;
    rdfs:label "Party"@en ;
    skos:definition "Any person or organization that takes part in a retail transaction."@en .

retail:Customer a owl:Class ;
    rdfs:subClassOf retail:Party , schema:Person ;
    rdfs:label "Customer"@en ;
    skos:definition "A person with an account who can place orders and write reviews."@en .

retail:PremiumCustomer a owl:Class ;
    rdfs:subClassOf retail:Customer ;
    rdfs:label "Premium customer"@en ;
    skos:definition "A customer with a paid membership (free shipping, etc.)."@en .

retail:Seller a owl:Class ;
    rdfs:subClassOf retail:Party , schema:Organization ;
    rdfs:label "Seller"@en ;
    skos:definition "An organization that lists products on the marketplace."@en .

retail:Product a owl:Class ;
    owl:equivalentClass schema:Product ;
    rdfs:label "Product"@en ;
    skos:definition "An item offered for sale, identified by a SKU."@en .

retail:Category a owl:Class ;
    rdfs:label "Category"@en ;
    skos:definition "A node in the product taxonomy (e.g. Electronics > Computers)."@en .

retail:Order a owl:Class ;
    rdfs:subClassOf schema:Order ;
    rdfs:label "Order"@en ;
    skos:definition "A purchase placed by exactly one customer, containing one or more order lines."@en ;
    # Every order is placed by exactly one customer ...
    rdfs:subClassOf [
        a owl:Restriction ;
        owl:onProperty retail:placedBy ;
        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass retail:Customer
    ] ;
    # ... and has at least one line.
    rdfs:subClassOf [
        a owl:Restriction ;
        owl:onProperty retail:hasLine ;
        owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass retail:OrderLine
    ] .

retail:OrderLine a owl:Class ;
    rdfs:label "Order line"@en ;
    skos:definition "One product + quantity + price within an order. Reifies the Order-Product relationship so it can carry attributes."@en ;
    rdfs:subClassOf [
        a owl:Restriction ;
        owl:onProperty retail:forProduct ;
        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass retail:Product
    ] .

retail:Address a owl:Class ;
    rdfs:subClassOf schema:PostalAddress ;
    rdfs:label "Address"@en .

retail:Review a owl:Class ;
    rdfs:subClassOf schema:Review ;
    rdfs:label "Review"@en ;
    skos:definition "A customer's rating (1-5) and optional text about a product."@en .

# Things that cannot be both at once
[] a owl:AllDisjointClasses ;
   owl:members ( retail:Party retail:Product retail:Category retail:Order
                 retail:OrderLine retail:Address retail:Review ) .

retail:Customer owl:disjointWith retail:Seller .

#---------------------------------------------------------------------------
# Object properties (relationships between resources)
#---------------------------------------------------------------------------
retail:placedBy a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "placed by"@en ;
    rdfs:domain retail:Order ;
    rdfs:range  retail:Customer ;
    owl:inverseOf retail:placedOrder .

retail:placedOrder a owl:ObjectProperty ;
    rdfs:label "placed order"@en ;
    rdfs:domain retail:Customer ;
    rdfs:range  retail:Order .

retail:hasLine a owl:ObjectProperty , owl:InverseFunctionalProperty ;
    rdfs:label "has line"@en ;
    rdfs:domain retail:Order ;
    rdfs:range  retail:OrderLine .

retail:forProduct a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "for product"@en ;
    rdfs:domain retail:OrderLine ;
    rdfs:range  retail:Product .

retail:inCategory a owl:ObjectProperty ;
    rdfs:label "in category"@en ;
    rdfs:domain retail:Product ;
    rdfs:range  retail:Category .

retail:subCategoryOf a owl:ObjectProperty , owl:TransitiveProperty ;
    rdfs:subPropertyOf skos:broader ;
    rdfs:label "sub-category of"@en ;
    rdfs:domain retail:Category ;
    rdfs:range  retail:Category ;
    rdfs:comment "Transitive: Computers subCategoryOf Electronics and Laptops subCategoryOf Computers entails Laptops subCategoryOf Electronics."@en .

retail:soldBy a owl:ObjectProperty ;
    rdfs:label "sold by"@en ;
    rdfs:domain retail:Product ;
    rdfs:range  retail:Seller .

retail:shipsTo a owl:ObjectProperty ;
    rdfs:label "ships to"@en ;
    rdfs:domain retail:Order ;
    rdfs:range  retail:Address .

retail:hasAddress a owl:ObjectProperty ;
    rdfs:label "has address"@en ;
    rdfs:domain retail:Customer ;
    rdfs:range  retail:Address .

retail:reviewOf a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "review of"@en ;
    rdfs:domain retail:Review ;
    rdfs:range  retail:Product .

retail:writtenBy a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "written by"@en ;
    rdfs:domain retail:Review ;
    rdfs:range  retail:Customer .

# A property chain: if a customer placed an order that has a line for a
# product, the customer "purchased" that product.
retail:purchased a owl:ObjectProperty ;
    rdfs:label "purchased"@en ;
    rdfs:domain retail:Customer ;
    rdfs:range  retail:Product ;
    owl:propertyChainAxiom ( retail:placedOrder retail:hasLine retail:forProduct ) .

#---------------------------------------------------------------------------
# Datatype properties (attributes with literal values)
#---------------------------------------------------------------------------
retail:name a owl:DatatypeProperty ;
    rdfs:subPropertyOf schema:name ;
    rdfs:label "name"@en ;
    rdfs:range xsd:string .

retail:email a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "email"@en ;
    rdfs:domain retail:Customer ;
    rdfs:range xsd:string .

retail:memberSince a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "member since"@en ;
    rdfs:domain retail:PremiumCustomer ;
    rdfs:range xsd:date .

retail:sku a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "SKU"@en ;
    rdfs:domain retail:Product ;
    rdfs:range xsd:string .

retail:price a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "list price (USD)"@en ;
    rdfs:domain retail:Product ;
    rdfs:range xsd:decimal .

retail:orderDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "order date"@en ;
    rdfs:domain retail:Order ;
    rdfs:range xsd:date .

retail:status a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "status"@en ;
    rdfs:domain retail:Order ;
    rdfs:range [ a rdfs:Datatype ;
                 owl:oneOf ( "PLACED" "SHIPPED" "DELIVERED" "CANCELLED" ) ] .

retail:paymentMethod a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "payment method"@en ;
    rdfs:domain retail:Order ;
    rdfs:range xsd:string .

retail:quantity a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "quantity"@en ;
    rdfs:domain retail:OrderLine ;
    rdfs:range xsd:positiveInteger .

retail:unitPrice a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "unit price paid (USD)"@en ;
    rdfs:comment "Price at time of purchase; may differ from the product's current list price."@en ;
    rdfs:domain retail:OrderLine ;
    rdfs:range xsd:decimal .

retail:rating a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "rating"@en ;
    rdfs:domain retail:Review ;
    rdfs:range [ a rdfs:Datatype ;
                 owl:onDatatype xsd:integer ;
                 owl:withRestrictions ( [ xsd:minInclusive 1 ] [ xsd:maxInclusive 5 ] ) ] .

retail:reviewText a owl:DatatypeProperty ;
    rdfs:label "review text"@en ;
    rdfs:domain retail:Review ;
    rdfs:range xsd:string .

retail:city       a owl:DatatypeProperty ; rdfs:label "city"@en ;        rdfs:domain retail:Address ; rdfs:range xsd:string .
retail:state      a owl:DatatypeProperty ; rdfs:label "state"@en ;       rdfs:domain retail:Address ; rdfs:range xsd:string .
retail:postalCode a owl:DatatypeProperty ; rdfs:label "postal code"@en ; rdfs:domain retail:Address ; rdfs:range xsd:string .
retail:country    a owl:DatatypeProperty ; rdfs:label "country"@en ;     rdfs:domain retail:Address ; rdfs:range xsd:string .
